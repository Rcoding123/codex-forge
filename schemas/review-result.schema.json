{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {"type": "string", "enum": ["pass", "changes_required"]},
    "summary": {"type": "string"},
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion": {"type": "string"},
          "met": {"type": "boolean"},
          "evidence": {"type": "string"}
        },
        "required": ["criterion", "met", "evidence"],
        "additionalProperties": false
      }
    },
    "binding_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {"type": "string"},
          "met": {"type": "boolean"},
          "evidence": {"type": "string"}
        },
        "required": ["text", "met", "evidence"],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "file": {"type": ["string", "null"]},
          "line": {"type": ["integer", "null"]},
          "issue": {"type": "string"},
          "required_fix": {"type": "string"}
        },
        "required": ["severity", "file", "line", "issue", "required_fix"],
        "additionalProperties": false
      }
    }
  },
  "required": ["verdict", "summary", "acceptance_criteria", "findings"],
  "additionalProperties": false
}
